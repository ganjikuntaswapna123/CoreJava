LARGER NUMBER USING ARRAY:
public class Larger {
    public static void main(String args[])
    {
        int a[]={1,2,3,4,5};
        int num=a[0];
        for(int i=1;i<a.length;i++)
        {
            if(a[i]>num)
            {
                num=a[i];
            }
        }
        System.out.println("Largest element is: "+num);
           
    }
       
}
