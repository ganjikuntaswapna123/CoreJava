ReverseArray Using While loop:
-> LeftRotation
public class ReverseArray {
    public static void main(String args[]) {
        int arr[]={1,2,3,4,5};
        int left=0;
        int right=arr.length-1;
        while(left<right) {
            int temp=arr[left];
            arr[left]=arr[right];
            arr[right]=temp;
            left++;
            right--;
        }
        for(int i=0;i<=arr.length-1;i++) {
            System.out.print(arr[i]+" ");
        }
    
    }
}
