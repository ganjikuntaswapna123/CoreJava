2D Array code:
public class TwoD {
    public static void main(String args[]) {
        int a[][]=new int[3][3];
        int sum=0;
        a[0][0]=10;
        a[0][1]=20;
        a[0][2]=30;
        a[1][0]=40;
        a[1][1]=50;
        a[1][2]=60;
        a[2][0]=70;
        a[2][1]=80;
        a[2][2]=90;
        for(int row=0;row<=a.length-1;row++) {
            for(int col=0;col<a.length-1;col++) {
                sum+=a[row][col];
            }
        }
        System.out.println("Sum of all elements: " + sum);
    }
}
