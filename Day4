        obj.delete(1,3);
        System.out.println(obj);
        obj.deleteCharAt(4);
        System.out.println(obj);
        obj.reverse();
        System.out.println(obj);
        obj.capacity();
        System.out.println(obj);
        obj.charAt(5);
        System.out.println(obj);
