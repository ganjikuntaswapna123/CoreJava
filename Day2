EVEN AND ODD TABLES:
import java.util.Scanner;
import java.lang.*;
public class For {
    public static void main(String args[]) {
        int num=10;
        System.out.println("Even tables.............");
        for(int i=1;i<=40;i++) {
            if(i % 2==0) {
                System.out.println("Multiplication table of " + i);
                System.out.println("Even tables:");
                for(int j=1; j<=num; j++) {
                 System.out.println(i + " * " + j + " = " +(i * j));
                }
            }
        }
        System.out.println("Odd tables...........");
        for(int i=1;i<=40;i++) {
            if(i % 2!=0) {
                System.out.println("Multiplication table of " + i);
                for(int j=1; j<=num; j++) {
                 System.out.println(i + " * " + j + " = " +(i * j));
                }
            }
        }
    }
}
