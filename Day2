CODE:
import java.lang.*;
import java.util.*;
public class If {
    public static void main(String args[]) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter a number:");
        int a = sc.nextInt();
        int b = sc.nextInt();
        if(a <= b) {
            System.out.print("Condition is true");
        }
        else {
            System.out.print("Condition is false");
        }
    }
}
