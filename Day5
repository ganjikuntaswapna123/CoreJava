2. Multilevel Inheritance
Syntax:
class A {
  //Block of code
}
class B extends  A {
  //Block of code
}
class C extends  B {
  //Block of code
}

CODE:
class A {
    void areaofRectangle(int a,int b) {
        int base=a;
        int height=b;
        double area=0.5*base*height;
        System.out.println("Area of a rectangle is "+area);
    }
}
class B extends A {
    void areaofSquare(int a) {
        System.out.println("Area of a square "+a*a);
    }
}
class C extends B {
    void perimeter(int a, int b) {
        int length=a;
        int breadth=b;
        int p=2*(length+breadth);
        System.out.println("Perimeter of a rectangle "+p);
    }
}
public class Multilevel {
    public static void main(String args[]) {
        C obj=new C();
        obj.areaofRectangle(4,8);
        obj.areaofSquare(5);
        obj.perimeter(12,4);
    }
}
