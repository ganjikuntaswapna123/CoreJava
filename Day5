3. Multiple Inheritance
Syntax:
interface A {
  //Block of code
}
interface B {
  //Block of code
}
class C implements A,B {
  //Block of code
}

CODE:
interface venu{
    void display();
}
interface vamshi{
    void msg();
}
class ven implements venu,vamshi{
    public void display(){
        System.out.println("Hello world");
    }
    public void msg(){
        System.out.println("hello vamshi");
    }
}
class Multiple{
    public static void main(String[] args) {
        ven obj= new ven();
        obj.display();
        obj.msg();
    }
}
